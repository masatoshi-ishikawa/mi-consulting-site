---
import '../styles/global.css';
import { SITE_DESCRIPTION, TITLE_SUFFIX } from '../consts';

interface Props {
  /** ページ固有の見出し。titleタグは「見出し｜石川雅敏｜タグライン」の形になる。 */
  title?: string;
  description?: string;
  /** publicディレクトリ基準のOGP画像パス。 */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  noindex = false,
} = Astro.props;

// titleタグには必ず名前を含める（指名検索の受け皿）
const fullTitle = title ? `${title}｜${TITLE_SUFFIX}` : TITLE_SUFFIX;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

{/* Google アナリティクス（GA4）。本番ビルドのときだけ出力する。 */}
{
  import.meta.env.PROD && (
    <>
      <script
        is:inline
        async
        src="https://www.googletagmanager.com/gtag/js?id=G-2JE1ECX70Z"
      />
      <script is:inline>
        {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-2JE1ECX70Z');`}
      </script>
    </>
  )
}

{/*
  Google Search Console の所有権確認用。
  Search Console側が このタグの有無を定期的に見に来るため、
  確認が通ったあとも消さないこと（消すと所有権が外れる）。
*/}
<meta
  name="google-site-verification"
  content="3Lpc0TcuGN-UoHmaWnODdMlEgqaOlaUzeLhBgyO5SCg"
/>

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={TITLE_SUFFIX} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
